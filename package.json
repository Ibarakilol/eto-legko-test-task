{
  "name": "eto-legko-test-task",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "lint": "yarn lint:ts && yarn lint:js",
    "lint:ts": "tsc --noEmit",
    "lint:js": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "prepare": "husky",
    "upgrade-dependencies": "yarn upgrade-interactive --latest"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": "eslint --max-warnings 0 --color",
    "*.{js,mjs,ts,json,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
